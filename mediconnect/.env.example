# ─── APPLICATION ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ─── DATABASE ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=mediconnect
DB_PASSWORD=mediconnect_dev_password
DB_NAME=mediconnect_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_to_another_long_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── PAYMENTS ──────────────────────────────────────────────────
# Options: mock | mpesa
PAYMENT_PROVIDER=mock

# M-Pesa Daraja (Sandbox)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/webhook
MPESA_ENVIRONMENT=sandbox

# ─── NOTIFICATIONS ─────────────────────────────────────────────
NOTIFICATION_PROVIDER=console
# Options: console | africastalking | sendgrid

# Africa's Talking (SMS)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=MEDICONNECT

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mediconnect.ke

# ─── MAPS ──────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# Leave blank to use free Nominatim geocoding fallback

# ─── SECURITY ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ─── LOGGING ───────────────────────────────────────────────────
LOG_LEVEL=debug
