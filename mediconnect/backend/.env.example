# ─── MEDICONNECT Backend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mediconnect
DB_USER=mediconnect_user
DB_PASSWORD=your_db_password_here
DB_CONNECTION_LIMIT=10

# JWT & Auth
JWT_ACCESS_SECRET=change_this_to_a_random_32_char_string_long_enough
JWT_REFRESH_SECRET=change_this_to_another_random_32_char_string_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=at_least_16_chars_cookie_secret_key!

# CORS
CORS_ORIGIN=http://localhost:5173

# Payments
PAYMENT_PROVIDER=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/webhook

# Notifications (Email via SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mediconnect.ke

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=MEDICONNECT

# Platform
PLATFORM_COMMISSION_RATE=0.15
DEFAULT_SEARCH_RADIUS_KM=20

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/mediconnect.log
