{
  "name": "mediconnect-backend",
  "version": "1.0.0",
  "description": "MEDICONNECT - Healthcare booking platform backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
